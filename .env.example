# Core appraisal
GEMINI_API_KEY=

# Optional Reverb draft integration
REVERB_TOKEN=

# Upstash Redis: required for scan usage, billing entitlements, and aggregate metrics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe server credentials
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave false until every Stripe/Redis setting has been tested. Set true for the paid public release.
MACHZERO_BILLING_ENFORCED=false

# Stripe recurring prices
STRIPE_PRICE_FLIP_MONTHLY=
STRIPE_PRICE_RESELLER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Stripe one-time scan-pack prices
STRIPE_PRICE_CREDITS_10=
STRIPE_PRICE_CREDITS_30=
STRIPE_PRICE_CREDITS_100=

# Canonical public app URL used for Stripe redirects
MACHZERO_APP_URL=https://machzero-beta.vercel.app

# Random secret used only to read the private aggregate metrics endpoint
MACHZERO_ADMIN_TOKEN=

# Random 32+ character server secret used to sign Reverb draft authorizations
MACHZERO_SIGNING_SECRET=
